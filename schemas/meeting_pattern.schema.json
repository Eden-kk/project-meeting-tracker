{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tracker.local/schemas/meeting_pattern.schema.json",
  "title": "MeetingPattern",
  "description": "Hermes-inferred description of a meeting's character. Full surface; the Phase-2 subset (primary_pattern + confidence only) is enforced at runtime per design-doc §12.1.",
  "type": "object",
  "required": ["primary_pattern", "confidence"],
  "additionalProperties": false,
  "properties": {
    "primary_pattern": {
      "type": "string",
      "description": "Open-ended label, e.g. customer_discovery_call, group_sync, technical_review."
    },
    "secondary_patterns": {
      "type": "array",
      "items": { "type": "string" },
      "default": [],
      "description": "Phase 4+. Empty in Phase 2."
    },
    "interaction_style": {
      "type": ["string", "null"],
      "description": "Phase 4+. Null in Phase 2."
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "reason": {
      "type": ["string", "null"],
      "description": "Phase 4+. Null in Phase 2."
    }
  }
}
