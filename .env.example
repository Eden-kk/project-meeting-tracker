# Copy to .env.local and fill in for local development.
# In this repo .env.local is gitignored and is the canonical place to put
# the live Postgres DSN.
DATABASE_URL=postgresql+psycopg://tracker:tracker@localhost:5433/tracker
BLOB_STORE_DIR=./var/blobs
INGEST_BACKEND=stub

# --- Slack bot MVP (optional) -------------------------------------------------
# When any of SLACK_BOT_TOKEN, SLACK_APP_TOKEN, or SLACK_DEFAULT_CHANNEL_ID is
# unset the bot stays dormant; everything else in the router runs unchanged.
# Bot user OAuth token from your Slack app's "OAuth & Permissions" page.
SLACK_BOT_TOKEN=xoxb-replace-me
# App-level token (Socket Mode) from "Basic Information" → "App-Level Tokens".
SLACK_APP_TOKEN=xapp-replace-me
# Channel ID (looks like C01234ABCDE) where the auto-post lands; right-click
# the channel name in Slack → "View channel details" to copy.
SLACK_DEFAULT_CHANNEL_ID=C01234ABCDE
# Public-facing base URL of the SPA — used to build deep-links inside Slack
# messages (e.g. https://<tunnel>.trycloudflare.com).
SLACK_FRONTEND_BASE_URL=https://example.trycloudflare.com
