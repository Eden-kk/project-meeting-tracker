# Copy to .env.local and fill in for local development.
# In this repo .env.local is gitignored and is the canonical place to put
# the live Postgres DSN.
DATABASE_URL=postgresql+psycopg://tracker:tracker@localhost:5433/tracker
BLOB_STORE_DIR=./var/blobs
INGEST_BACKEND=stub

# Zoom Marketplace credentials (Wave 9 — zoom-bot integration).
# All FOUR must be set before POST /api/zoom-bot/dispatch will succeed;
# missing creds surface as a 503 (the SPA still loads without them).
#   - ZOOM_SDK_KEY / ZOOM_SDK_SECRET  → Meeting SDK app (signs the JWT
#     the headless Web SDK uses to join a meeting).
#   - ZOOM_OAUTH_CLIENT_ID / _SECRET  → User-managed OAuth app (reserved
#     for the future user-grant flow; NOT used to sign Meeting SDK JWTs).
ZOOM_SDK_KEY=
ZOOM_SDK_SECRET=
ZOOM_OAUTH_CLIENT_ID=
ZOOM_OAUTH_CLIENT_SECRET=
# Informational only — the dedicated bot Zoom account email. Shows up as
# the bot's profile/display name in the Zoom UI. NOT used for auth.
ZOOM_BOT_ACCOUNT_EMAIL=
# Cap on concurrent bot subprocesses on this pod. Default 3.
ZOOM_BOT_POOL_SIZE=3
# Override only if bot.py lives somewhere other than `$REPO_ROOT/bot`.
# ZOOM_BOT_DIR=
